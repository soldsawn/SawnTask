<Window x:Class="SawnTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SawnTask.Ui"
        Title="SawnTask" Icon="Assets/SawnTask.ico" Width="1320" Height="860" MinWidth="900" MinHeight="600"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- All colours and texts are {DynamicResource ...}: Themes/*.xaml and Strings/*.xaml
         can be swapped at run time (Settings page) and the window updates immediately. -->
    <Window.Resources>
        <ui:IconConverter x:Key="IconOf"/>
        <ui:ByteTextConverter x:Key="ByteText"/>
        <ui:HeatBrushConverter x:Key="HeatBrush"/>
        <!-- One row of a process list with PID, icon + name, CPU and memory (Summary top list, CPU History). -->
        <DataTemplate x:Key="TopRowTemplate">
                                            <Grid Margin="0,1" Background="{Binding Heat, Converter={StaticResource HeatBrush}}" Cursor="Hand"
                                                  MouseLeftButtonUp="TopRow_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Pid}" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource IconOf}}" Width="16" Height="16" Margin="0,0,6,0"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Cpu, StringFormat={}{0:0.0}%}" HorizontalAlignment="Right" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PrivateBytes, Converter={StaticResource ByteText}}" HorizontalAlignment="Right" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
        <!-- Process name with its program icon (Processes and Users pages). -->
        <DataTemplate x:Key="ProcessNameCell">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation: each item's Tag is the index of its TabItem below, so the menu
             order can differ from the page order. The pages after the "More" divider fold
             away; MainWindow.SetMoreOpen shows or hides them. -->
        <DockPanel Background="{DynamicResource Side}">
            <TextBlock DockPanel.Dock="Top" Text="SawnTask" FontSize="24" FontWeight="Light"
                       Foreground="{DynamicResource Brand}" Margin="18,16,0,18"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NavTheme" Style="{StaticResource NavButton}" Click="NavTheme_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Set.Theme}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ThemeMenu" Placement="Top">
                            <MenuItem Header="{DynamicResource Set.Dark}" Tag="Dark" Click="ThemeMenu_Click"/>
                            <MenuItem Header="{DynamicResource Set.Light}" Tag="Light" Click="ThemeMenu_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem ui:NavIcon.Glyph="&#xE80F;" Content="{DynamicResource Nav.Summary}" Tag="0"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE9D9;" Content="{DynamicResource Nav.Performance}" Tag="1"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE9F5;" Content="{DynamicResource Nav.Processes}" Tag="2"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE946;" Content="{DynamicResource Nav.SystemInfo}" Tag="12"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE945;" Content="{DynamicResource Nav.Power}" Tag="13"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE77B;" Content="{DynamicResource Nav.Users}" Tag="3"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE7E8;" Content="{DynamicResource Nav.Startup}" Tag="5"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xEDA2;" Content="{DynamicResource Nav.Disk}" Tag="9"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xEC4A;" Content="{DynamicResource Nav.DiskBench}" Tag="14"/>
                <ListBoxItem x:Name="NavMore" Content="{DynamicResource Nav.More}" Style="{StaticResource NavMore}"
                             PreviewMouseLeftButtonDown="NavMore_Click"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE774;" Content="{DynamicResource Nav.Connections}" Tag="4"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE9CE;" Content="{DynamicResource Nav.Services}" Tag="6"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE71D;" Content="{DynamicResource Nav.Installed}" Tag="7"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE772;" Content="{DynamicResource Nav.Drivers}" Tag="8"/>
                <ListBoxItem ui:NavIcon.Glyph="&#xE8A5;" Content="{DynamicResource Nav.Sources}" Tag="10"/>
            </ListBox>
        </DockPanel>

        <TabControl x:Name="Pages" Grid.Column="1"
                    Background="Transparent" Foreground="{DynamicResource Fg}" BorderThickness="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <!-- Tab content inherits text color from its TabItem, which the theme makes black. -->
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Summary -->
            <TabItem>
                <DockPanel Margin="10">
                    <Border x:Name="ReplayBanner" DockPanel.Dock="Top" Background="{DynamicResource Banner}" CornerRadius="4"
                            Padding="10,6" Margin="5,0,5,5" Visibility="Collapsed">
                        <TextBlock x:Name="ReplayText"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="1.6*"/>
                            <RowDefinition Height="1.4*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Grid.ColumnSpan="3">
                            <DockPanel>
                                <Grid x:Name="CpuHeader" DockPanel.Dock="Top" Margin="0,0,0,6" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CpuTitle" Text="{DynamicResource Sum.Cpu}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{DynamicResource Sum.Utilization}" Foreground="#66BB6A" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <TextBlock Text="{DynamicResource Sum.KernelLegend}" Foreground="#EF5350" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBlock Text="{DynamicResource Sum.TempLegend}" Foreground="#FFA726" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CpuValue" Style="{StaticResource CardValue}" Foreground="#66BB6A"/>
                                </Grid>
                                <TextBlock x:Name="CpuDetail" DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                                <ui:LineGraph x:Name="CpuGraph"/>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="3">
                            <DockPanel>
                                <TextBlock x:Name="TopTitle" DockPanel.Dock="Top" Text="{DynamicResource Sum.TopProcesses}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <Grid x:Name="TopHeader" DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Col.Pid}" Foreground="{DynamicResource Dim}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Col.Name}" Foreground="{DynamicResource Dim}" FontSize="11" Margin="22,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Col.Cpu}" Foreground="{DynamicResource Dim}" FontSize="11" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{DynamicResource Col.Memory}" Foreground="{DynamicResource Dim}" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <ScrollViewer x:Name="TopScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TopList" ItemTemplate="{StaticResource TopRowTemplate}"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="3">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Sum.Sensors}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="TempValue" Style="{StaticResource CardValue}" Foreground="#FB8C00"/>
                                </Grid>
                                <ui:LineGraph x:Name="TempGraph" DockPanel.Dock="Top" Height="44"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl x:Name="SensorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Source}" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Row="1" Grid.ColumnSpan="3">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Sum.Memory}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="MemValue" Style="{StaticResource CardValue}" Foreground="#AB47BC"/>
                                </Grid>
                                <TextBlock x:Name="MemDetail" DockPanel.Dock="Bottom" Style="{StaticResource CardDetail}"/>
                                <ui:LineGraph x:Name="MemGraph"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Row="2">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Sum.Network}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="NetValue" Style="{StaticResource CardValue}" Foreground="#039BE5"/>
                                </Grid>
                                <TextBlock x:Name="NetDetail" DockPanel.Dock="Bottom" Style="{StaticResource CardDetail}"/>
                                <ui:LineGraph x:Name="NetGraph"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Row="2" Grid.Column="1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Sum.Disks}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="DiskValue" Style="{StaticResource CardValue}" Foreground="#7CB342"/>
                                </Grid>
                                <TextBlock x:Name="DiskDetail" DockPanel.Dock="Bottom" Style="{StaticResource CardDetail}"/>
                                <ui:LineGraph x:Name="DiskGraph"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Row="2" Grid.Column="2">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Sum.Gpu}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="GpuValue" Style="{StaticResource CardValue}" Foreground="#1E88E5"/>
                                </Grid>
                                <TextBlock x:Name="GpuDetail" DockPanel.Dock="Bottom" Style="{StaticResource CardDetail}"/>
                                <ui:LineGraph x:Name="GpuGraph"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Row="2" Grid.Column="3">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Sum.CpuPower}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="PowerValue" Style="{StaticResource CardValue}" Foreground="#EF5350"/>
                                </Grid>
                                <TextBlock x:Name="PowerDetail" DockPanel.Dock="Bottom" Style="{StaticResource CardDetail}"/>
                                <ui:LineGraph x:Name="PowerGraph"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Performance (design placeholder) -->
            <TabItem>
                <ui:PerformancePage x:Name="Perf"/>
            </TabItem>

            <!-- Processes -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Proc.Title}" Style="{StaticResource PageTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Proc.Filter}" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" Margin="0,0,8,0"/>
                            <TextBox x:Name="FilterBox" Width="240" TextChanged="FilterBox_TextChanged"/>
                            <Button Content="{DynamicResource Proc.EndTask}" Margin="10,0,0,0" Click="EndTask_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Proc.Note}"/>
                    <DataGrid x:Name="ProcGrid" Sorting="ProcGrid_Sorting" ContextMenuOpening="ProcGrid_ContextMenuOpening"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <!-- "Apps (9)" / "Background processes (32)" group headers. -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="6,10,0,4" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource GroupHeader}">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="ProcMenu">
                                <MenuItem Header="{DynamicResource Proc.EndTask}" Click="EndTask_Click"/>
                                <MenuItem Header="{DynamicResource Proc.Suspend}" Click="Suspend_Click"/>
                                <MenuItem Header="{DynamicResource Proc.Resume}" Click="Resume_Click"/>
                                <MenuItem x:Name="PriorityMenu" Header="{DynamicResource Proc.Priority}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Proc.OpenLocation}" Click="OpenLocation_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExited}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ExitedRow}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn ui:LocHeader.Key="Col.Name" SortMemberPath="Name" Width="230" CellTemplate="{StaticResource ProcessNameCell}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Pid" Binding="{Binding Pid}" Width="65" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.User" Binding="{Binding User}" Width="110"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Cpu" Binding="{Binding CpuText}" SortMemberPath="CpuSort" SortDirection="Descending" Width="65" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.MemPrivate" Binding="{Binding MemText}" SortMemberPath="MemSort" Width="115" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.WorkingSet" Binding="{Binding WsText}" SortMemberPath="WsSort" Width="100" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.PeakMem" Binding="{Binding PeakText}" SortMemberPath="PeakSort" Width="110" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.IoRead" Binding="{Binding ReadText}" SortMemberPath="ReadSort" Width="90" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.IoWrite" Binding="{Binding WriteText}" SortMemberPath="WriteSort" Width="90" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.CpuTime" Binding="{Binding CpuTimeText}" SortMemberPath="CpuTimeSort" Width="90" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.PageFaults" Binding="{Binding PageFaults}" Width="95" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Threads" Binding="{Binding Threads}" Width="95" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Handles" Binding="{Binding Handles}" Width="85" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Session" Binding="{Binding Session}" Width="65" ElementStyle="{StaticResource Num}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Users -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Users.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Users.Note}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="80"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="UsersGrid" SelectionChanged="UsersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn ui:LocHeader.Key="Col.UserCol" Binding="{Binding User}" Width="220"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Session" Binding="{Binding SessionId}" Width="70" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Status" Binding="{Binding State}" Width="100"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Cpu" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="70" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Processes" Binding="{Binding Processes}" Width="80" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Station" Binding="{Binding Station}" Width="100"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Client" Binding="{Binding Client}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="UserProcGrid" Grid.Row="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn ui:LocHeader.Key="Col.Process" SortMemberPath="Name" Width="250" CellTemplate="{StaticResource ProcessNameCell}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Pid" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Status" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.Cpu" Binding="{Binding CpuText}" SortMemberPath="CpuSort" Width="70" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.MemPrivate" Binding="{Binding MemText}" SortMemberPath="MemSort" Width="130" ElementStyle="{StaticResource Num}"/>
                                <DataGridTextColumn ui:LocHeader.Key="Col.User" Binding="{Binding User}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Connections -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Conn.Title}" Style="{StaticResource PageTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Conn.Show}" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ConnFilter" Width="150" SelectedIndex="0" SelectionChanged="ConnFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Conn.All}"/>
                                <ComboBoxItem Content="{DynamicResource Conn.Established}"/>
                                <ComboBoxItem Content="{DynamicResource Conn.Listening}"/>
                                <ComboBoxItem Content="{DynamicResource Conn.Internet}"/>
                                <ComboBoxItem Content="{DynamicResource Conn.Udp}"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ConnSummary" DockPanel.Dock="Top" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Conn.Note}"/>
                    <DataGrid x:Name="ConnGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Application" Binding="{Binding Process}" Width="170"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Pid" Binding="{Binding Pid}" Width="60" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Protocol" Binding="{Binding Protocol}" Width="70"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.State" Binding="{Binding State}" Width="95"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Local" Binding="{Binding Local}" Width="210"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Remote" Binding="{Binding Remote}" Width="230"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Service" Binding="{Binding Service}" Width="70"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Exposure" Binding="{Binding Exposure}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Startup apps -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Startup.Title}" Style="{StaticResource PageTitle}"/>
                        <Button Content="{DynamicResource Startup.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleStartup_Click"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Startup.Note}"/>
                    <DataGrid x:Name="StartupGrid">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn ui:LocHeader.Key="Col.Enabled" Binding="{Binding Enabled, Mode=OneWay}" Width="65" ElementStyle="{StaticResource GridCheck}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Name" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Command" Binding="{Binding Command}" Width="*"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Location" Binding="{Binding Location}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Services -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Services.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Services.Note}"/>
                    <DataGrid x:Name="ServicesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Name" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Pid" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.State" Binding="{Binding State}" Width="90"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.HostedIn" Binding="{Binding Kind}" Width="110"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.DisplayName" Binding="{Binding DisplayName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Installed apps -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Apps.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Apps.Note}"/>
                    <DataGrid x:Name="AppsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Application" Binding="{Binding Name}" Width="260"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Publisher" Binding="{Binding Publisher}" Width="190"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Version" Binding="{Binding Version}" Width="130"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Installed" Binding="{Binding Installed}" Width="90"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.EstSize" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="110" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Scope" Binding="{Binding Scope}" Width="130"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Source" Binding="{Binding Source}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Drivers -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Drivers.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Drivers.Note}"/>
                    <DataGrid x:Name="DriversGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Driver" Binding="{Binding DisplayName}" Width="260"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Name" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.State" Binding="{Binding State}" Width="75"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.StartType" Binding="{Binding StartType}" Width="95"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Type" Binding="{Binding Kind}" Width="85"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Version" Binding="{Binding Version}" Width="125"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Vendor" Binding="{Binding Vendor}" Width="170"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.File" Binding="{Binding Path}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Disk space (TreeSize-style scanner) -->
            <TabItem>
                <ui:DiskSpacePage x:Name="DiskPage"/>
            </TabItem>

            <!-- Sources -->
            <TabItem>
                <DockPanel Margin="15,10,15,10">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Sources.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Sources.Note}"/>
                    <DataGrid x:Name="SourcesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Id" Binding="{Binding Id}" Width="190"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Health" Binding="{Binding Health}" Width="85"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.LastGood" Binding="{Binding LastGoodText}" Width="85"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.Detail" Binding="{Binding Detail}" Width="300"/>
                            <DataGridTextColumn ui:LocHeader.Key="Col.How" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem>
                <!-- Two columns of section cards. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel Margin="15,10,15,10">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Set.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Text="{DynamicResource Set.Note}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.Appearance}" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Set.Language}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="LanguageBox" Grid.Column="1" MaxWidth="240" HorizontalAlignment="Stretch" SelectionChanged="Appearance_Changed">
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Set.Theme}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ThemeBox" Grid.Row="2" Grid.Column="1" MaxWidth="240" SelectionChanged="Appearance_Changed">
                                            <ComboBoxItem Content="{DynamicResource Set.Dark}" Tag="Dark"/>
                                            <ComboBoxItem Content="{DynamicResource Set.Light}" Tag="Light"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource Set.Graphs}" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Set.Fps}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <ComboBox x:Name="FpsBox" Grid.Column="1" MaxWidth="240" SelectionChanged="Graphs_Changed">
                                                <ComboBoxItem Content="{DynamicResource Set.FpsOff}" Tag="0"/>
                                                <ComboBoxItem Content="30 fps" Tag="30"/>
                                                <ComboBoxItem Content="60 fps" Tag="60"/>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Note}" Text="{DynamicResource Set.FpsNote}" Margin="0,6,0,12"/>
                                        <CheckBox x:Name="SmoothBox" Style="{StaticResource Switch}" Content="{DynamicResource Set.Smooth}"
                                                  Checked="Graphs_Changed" Unchecked="Graphs_Changed"/>
                                        <TextBlock Style="{StaticResource Note}" Text="{DynamicResource Set.SmoothNote}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Set.General}" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Bar.UpdateSpeed}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="SettingsSpeedBox" Grid.Column="1" MaxWidth="240" SelectionChanged="SettingsSpeed_Changed">
                                            <ComboBoxItem Content="{DynamicResource Speed.High}" Tag="500"/>
                                            <ComboBoxItem Content="{DynamicResource Speed.Normal}" Tag="1000"/>
                                            <ComboBoxItem Content="{DynamicResource Speed.Low}" Tag="2000"/>
                                            <ComboBoxItem Content="{DynamicResource Speed.Paused}" Tag="0"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Set.StartPage}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="StartPageBox" Grid.Row="2" Grid.Column="1" MaxWidth="240" SelectionChanged="StartPage_Changed"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource Set.Admin}" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="AdminText" Style="{StaticResource Note}" Margin="0,0,0,10"/>
                                        <Button x:Name="SettingsAdminBtn" Content="{DynamicResource Disk.Admin}" HorizontalAlignment="Left" Click="SettingsAdmin_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>


            <!-- System Info (tab 12: the menu order differs from the tab order, each menu item's Tag is its tab) -->
            <TabItem>
                <ui:SystemInfoPage x:Name="SysInfo"/>
            </TabItem>

            <!-- Power plans (tab 13) -->
            <TabItem>
                <ui:PowerPlansPage x:Name="PowerPage"/>
            </TabItem>

            <!-- Disk speed test (tab 14) -->
            <TabItem>
                <ui:DiskBenchPage x:Name="BenchPage"/>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Side}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Dim}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource Bar.UpdateSpeed}" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SpeedBox" Width="130" SelectionChanged="SpeedBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Speed.High}" Tag="500"/>
                    <ComboBoxItem Content="{DynamicResource Speed.Normal}" Tag="1000"/>
                    <ComboBoxItem Content="{DynamicResource Speed.Low}" Tag="2000"/>
                    <ComboBoxItem Content="{DynamicResource Speed.Paused}" Tag="0"/>
                </ComboBox>
                <Button x:Name="RecordBtn" Content="{DynamicResource Bar.Record}" Margin="12,0,0,0" Padding="10,2" Click="Record_Click"/>
                <TextBlock x:Name="RecordTime" Text="00:00:00" FontFamily="Consolas" FontSize="15" Foreground="{DynamicResource Brand}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource Bar.OpenRecording}" Margin="12,0,0,0" Padding="10,2" Click="OpenRecording_Click"/>
                <Button x:Name="LiveBtn" Content="{DynamicResource Bar.BackToLive}" Margin="6,0,0,0" Padding="10,2" Visibility="Collapsed" Click="BackToLive_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
