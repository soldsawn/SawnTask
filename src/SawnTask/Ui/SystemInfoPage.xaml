<UserControl x:Class="SawnTask.Ui.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SawnTask.Ui">
    <!-- The System Info page: a list of categories on the left, a Property / Value table on the right. -->
    <DockPanel Margin="15,10,15,10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource SI.Title}" Style="{StaticResource PageTitle}"/>
            <Button Content="{DynamicResource SI.Refresh}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,4" Click="Refresh_Click"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Categories" Background="{DynamicResource Panel}" BorderThickness="0" Margin="0,0,10,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Categories_SelectionChanged"/>
            <DataGrid x:Name="Table" Grid.Column="1" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn ui:LocHeader.Key="SI.Property" Binding="{Binding Property}" Width="260">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Hint}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                <Setter Property="Margin" Value="4,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn ui:LocHeader.Key="SI.Value" Binding="{Binding Value}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
