<UserControl x:Class="SawnTask.Ui.PowerPlansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Fg}">
    <!-- Windows power plans: pick the active one, copy, rename, delete, and edit a few settings. -->
    <DockPanel Margin="15,10,15,10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource PP.Title}" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ActivateButton" Content="{DynamicResource PP.Activate}" Padding="14,4" Margin="0,0,6,0" Click="Activate_Click"/>
                <Button Content="{DynamicResource PP.New}" Padding="14,4" Margin="0,0,6,0" Click="New_Click"/>
                <Button x:Name="RenameButton" Content="{DynamicResource PP.Rename}" Padding="14,4" Margin="0,0,6,0" Click="Rename_Click"/>
                <Button x:Name="DeleteButton" Content="{DynamicResource PP.Delete}" Padding="14,4" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,10" Text="{DynamicResource PP.Note}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Plans" Background="{DynamicResource Panel}" BorderThickness="0"
                     ItemContainerStyle="{StaticResource SubNavItem}" SelectionChanged="Plans_SelectionChanged"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="PlanTitle" FontSize="22" FontWeight="Light" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                            <Grid x:Name="SettingsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Extra settings: everything in Windows' "Change advanced power settings", read when opened. -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,10">
                        <StackPanel>
                            <ToggleButton x:Name="ExtraToggle" Checked="ExtraToggle_Changed" Unchecked="ExtraToggle_Changed"
                                          Cursor="Hand" HorizontalContentAlignment="Left" Foreground="{DynamicResource Fg}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{DynamicResource PP.Extra}" FontSize="16"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <StackPanel x:Name="ExtraPanel" Visibility="Collapsed" Margin="0,8,0,4">
                                <TextBlock Style="{StaticResource Note}" Text="{DynamicResource PP.ExtraNote}" Margin="0,0,0,8"/>
                                <!-- One framed box per Windows group: its title on top, its settings inside. -->
                                <StackPanel x:Name="ExtraList"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
