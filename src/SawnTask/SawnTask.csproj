<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SawnTask</AssemblyName>
    <RootNamespace>SawnTask</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\SawnTask.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>SawnTask</Product>
    <Company>soldsawn</Company>
    <Copyright>Copyright (c) 2026 soldsawn</Copyright>
    <Description>A Windows system monitor: live graphs, processes, hardware facts and power plans.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon is the window's (and so the taskbar's) icon. -->
    <Resource Include="Assets\SawnTask.ico" />
  </ItemGroup>

</Project>
