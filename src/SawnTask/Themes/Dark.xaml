<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every colour the UI uses. Light.xaml has the same keys; switching theme swaps this
         whole dictionary, and everything that uses {DynamicResource ...} repaints. -->
    <SolidColorBrush x:Key="Bg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Panel" Color="#252526"/>
    <SolidColorBrush x:Key="Side" Color="#202020"/>
    <SolidColorBrush x:Key="Line" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#2F5DAA"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brand" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="CtrlBg" Color="#2D2D30"/>
    <SolidColorBrush x:Key="CtrlHover" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="CtrlBorder" Color="#555555"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#2D2D30"/>
    <SolidColorBrush x:Key="AltRow" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="ExitedRow" Color="#4A2A2A"/>
    <SolidColorBrush x:Key="Banner" Color="#5D4037"/>
    <SolidColorBrush x:Key="GraphBg" Color="#181818"/>
    <SolidColorBrush x:Key="GraphGrid" Color="#303030"/>
    <SolidColorBrush x:Key="BarTrack" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Folder" Color="#E0B050"/>
    <SolidColorBrush x:Key="ScrollTrack" Color="#232323"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A4A4E"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#6A6A70"/>
    <SolidColorBrush x:Key="GroupHeader" Color="#4FC3F7"/>
    <!-- Windows' own "control" colour paints the corner where a grid's two scroll bars meet. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#232323"/>
    <!-- Selected rows in a grid that does not have focus (Windows would use light grey). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A4A66"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
</ResourceDictionary>
