<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as Dark.xaml. -->
    <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Side" Color="#E9E9EC"/>
    <SolidColorBrush x:Key="Line" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="Fg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Dim" Color="#5E5E66"/>
    <SolidColorBrush x:Key="Accent" Color="#2F5DAA"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brand" Color="#0B7CB8"/>
    <SolidColorBrush x:Key="CtrlBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CtrlHover" Color="#E6EEF8"/>
    <SolidColorBrush x:Key="CtrlBorder" Color="#B4B4BC"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#ECECF0"/>
    <SolidColorBrush x:Key="AltRow" Color="#F7F7F9"/>
    <SolidColorBrush x:Key="ExitedRow" Color="#F8D7D7"/>
    <SolidColorBrush x:Key="Banner" Color="#FFE0B2"/>
    <SolidColorBrush x:Key="GraphBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GraphGrid" Color="#E2E2E6"/>
    <SolidColorBrush x:Key="BarTrack" Color="#E4E4E8"/>
    <SolidColorBrush x:Key="Folder" Color="#C8961E"/>
    <SolidColorBrush x:Key="ScrollTrack" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C4C4CC"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#9E9EA8"/>
    <SolidColorBrush x:Key="GroupHeader" Color="#0B7CB8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CCDDF5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E1E1E"/>
</ResourceDictionary>
